{
  "name": "kepler-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Application web pédagogique pour l'étude des 2e et 3e lois de Kepler à partir de données satellites réelles (N2YO / SGP4)",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "seed": "node collector/seed_archive.mjs",
    "collect": "node collector/collect.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "satellite.js": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vitest": "^3.0.7"
  }
}
